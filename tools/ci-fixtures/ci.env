# CI の compose 検査用のダミーの値（F-14.1、F-18.6、T-119）。本物の値と秘密を置かない。
# F-18.6 の対応表の AX_ の変数をすべて持つ。表にない AX_GATE_PORT は D-14 の ${bind_addr}:${gate_port} 用（OPEN.md を見る）。
# パスは tools/ci-fixtures/ の下の相対パス（compose の --project-directory をリポジトリの根にして使う）。
AX_HOME=.
AX_HOST=ci-host
AX_BIND_ADDR=127.0.0.1
AX_SECRETS_DIR=./tools/ci-fixtures/secrets
AX_TMP_DIR=./tools/ci-fixtures/tmp
AX_STATE_DIR=./tools/ci-fixtures/state
AX_COMMANDER_DIR=./tools/ci-fixtures/state/commander
AX_ARCHIVE_TARGET=ci-archive
AX_MEMORY_ENDPOINT=http://memory.ci.invalid:8377/mcp/
AX_MODEL_GATEWAY=http://198.51.100.1:3425
AX_NTFY_ENDPOINT=http://ntfy.ci.invalid:8908
AX_NTFY_TOPIC=ci
AX_ENVIRONMENTS_FILE=config/environments.yaml
AX_MODELS_FILE=config/models.yaml
AX_PUBLIC_PROXY_IP=192.0.2.1
AX_UID=1000
AX_GID=1000
AX_HQ_UID=1001
AX_HQ_GID=1001
AX_TAG=ci
AX_GATE_PORT=8909
AX_ENTRY_SITES_FILE=./tools/ci-fixtures/ci.env
AX_AUTOMATION_MAP_SOURCE=./tools/ci-fixtures/ci.env

AX_CONVERSATION_HISTORY_HOST_DIR=./tools/ci-fixtures/state
AX_EMBEDDING_TOKEN_HOST_FILE=./tools/ci-fixtures/secrets/x-session-cookie
