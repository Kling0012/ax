AX_WORK_GATEWAY=198.51.100.1
AX_PUBLISH_REVIEW_SUBNET=192.0.2.128/26
AX_PUBLISH_REVIEW_GATEWAY=192.0.2.129
AX_JOB_SUBNET=203.0.113.0/25
AX_JOB_GATEWAY=203.0.113.1
