# SSH hostname or address of the launcher.
AX_LAUNCHER_HOST=192.0.2.1
# SSH username for the launcher.
AX_LAUNCHER_USER=launcher
# User scope for memory connector searches and writes.
AX_MEMCONN_USER=operator
# Registered local environment ID for worker placement.
AX_WORKER_LOCAL_ENV_ID=
# Local intake principal used by vias and seat.
AX_LOCAL_PRINCIPAL=local-operator
# Retirement helper archive subdirectory name.
AX_RETIREMENT_ARCHIVE_NAME=issue-automation-old
# Optional retirement role; export these in the retirement process environment.
# AX_COMPUTE_ROLE=compute
# AX_COMPUTE_LEGACY_KEYS=

# Optional comma-separated legacy IDs used for read-only publisher history.
# AX_PUBLISH_LEGACY_PLUGIN_IDS=


# Network configuration
