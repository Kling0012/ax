{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b18b/screenshot/meta.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["final_url", "title", "http_status", "width", "height", "captured_at", "mode", "ignored_args"],
  "properties": {
    "final_url": {"type": "string"},
    "title": {"type": ["string", "null"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["fullpage", "viewport"]},
    "source": {"type": "string", "minLength": 1},
    "impl": {"enum": ["run", "expand"]},
    "ignored_args": {"type": "array", "uniqueItems": true, "items": {"enum": ["full_page", "width", "height", "headed"]}}
  }
}
