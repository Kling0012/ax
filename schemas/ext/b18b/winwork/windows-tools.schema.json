{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b18b/winwork/windows-tools.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tools"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "location",
          "max_concurrent",
          "owner_use",
          "data_classes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "const": "windows-computer-use"
          },
          "location": {
            "type": "string",
            "pattern": "^windows_[a-z0-9_]+_target$"
          },
          "max_concurrent": {
            "const": 1
          },
          "owner_use": {
            "type": "boolean"
          },
          "data_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "public",
                "private",
                "sensitive"
              ]
            }
          }
        }
      }
    }
  }
}
