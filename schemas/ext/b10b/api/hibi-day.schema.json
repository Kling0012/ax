{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b10b/api/hibi-day.schema.json",
  "title": "GET /v1/hibi/day response (S-22.6, F-25)",
  "type": "object",
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tz": {"const": "Asia/Tokyo"},
    "as_of": {"anyOf": [{"$ref": "../../../common.schema.json#/$defs/ts_any"}, {"type": "null"}]},
    "segments": {"type": "array", "items": {"type": "object", "properties": {"start": {"$ref": "../../../common.schema.json#/$defs/ts_any"}, "end": {"$ref": "../../../common.schema.json#/$defs/ts_any"}, "state": {"enum": ["away", "play", "focus", "break", "shallow"]}, "category": {"enum": ["work", "research", "communication", "media", "play", "other"]}, "session_title": {"anyOf": [{"type": "string", "maxLength": 40}, {"type": "null"}]}}, "required": ["start", "end", "state", "category", "session_title"], "additionalProperties": false}},
    "state": {"const": "unknown"}
  },
  "required": ["date", "tz", "as_of", "segments"],
  "additionalProperties": false
}
