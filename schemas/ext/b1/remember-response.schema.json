{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b1/remember-response.schema.json",
  "title": "POST /v1/remember の応答",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "saved",
        "superseded",
        "duplicate",
        "queued",
        "unknown"
      ]
    },
    "memory_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "enrichment_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
