{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b1/export-response.schema.json",
  "title": "POST /v1/export の応答",
  "type": "object",
  "properties": {
    "exported": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "exported",
    "files",
    "last_seq"
  ],
  "additionalProperties": false
}
