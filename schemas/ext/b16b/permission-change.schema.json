{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b16b/permission-change.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "*"
      }
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "*"
      }
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "*"
      }
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "*"
      }
    },
    "source_instruction": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "*"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "const": "*"
        }
      }
    },
    "conditions": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "branch_cleanup": {}
  },
  "required": [
    "project",
    "repo",
    "destination",
    "operations",
    "source_instruction"
  ],
  "additionalProperties": false
}
