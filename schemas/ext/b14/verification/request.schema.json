{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b14/verification/request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["repo", "base_sha", "head_sha", "test_recipe", "untrusted", "files_complete", "changed_files"],
  "properties": {
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "head_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "test_recipe": {"type": "string", "minLength": 1},
    "verify_runner": {"type": "string", "minLength": 1},
    "untrusted": {"type": "boolean"}, "balance_changed": {"type": "boolean"},
    "files_complete": {"type": "boolean"},
    "changed_files": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "status", "binary"],
      "properties": {"path": {"type": "string", "minLength": 1}, "old_path": {"type": "string", "minLength": 1},
        "status": {"enum": ["added", "modified", "deleted", "renamed"]}, "binary": {"type": "boolean"}},
      "allOf": [{"if": {"properties": {"status": {"const": "renamed"}}}, "then": {"required": ["old_path"]}}]
    }},
    "untrusted_forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outbound_allowlist": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"}}
  }
}
