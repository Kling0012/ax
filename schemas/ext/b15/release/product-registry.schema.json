{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b15/release/product-registry.schema.json",
  "title": "製品登録簿の最小形（S-16.6、S-20.5）",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "project": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "destination": {"type": "string", "minLength": 1},
          "operations": {"type": "array", "minItems": 1},
          "publish_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "version": {"type": "object"},
          "notes": {"type": "object"},
          "entry": {"type": "object"},
          "checks": {"type": "object"},
          "post_publish": {"type": "array"},
          "credentials": {"type": "array"}
        },
        "required": ["id", "project", "repo", "destination", "operations", "publish_paths", "version", "notes", "entry", "checks", "post_publish"],
        "additionalProperties": true
      }
    }
  },
  "required": ["schema_version", "products"],
  "additionalProperties": false
}
