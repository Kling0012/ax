{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b15/gate/publication-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_ref",
    "version",
    "attempt",
    "checks",
    "outcome",
    "reason",
    "at"
  ],
  "properties": {
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "outcome"
            ],
            "properties": {
              "kind": {
                "const": "machine"
              },
              "name": {
                "enum": [
                  "secret_pii",
                  "internal_information",
                  "image_gps"
                ]
              },
              "outcome": {
                "enum": [
                  "ok",
                  "ng",
                  "unsure"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "location",
                    "type"
                  ],
                  "properties": {
                    "status": {"const": "allowed"},
                    "allow_key": {
                      "type": "object", "additionalProperties": false,
                      "required": ["rule", "path", "sha256"],
                      "properties": {"rule": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
                    },
                    "location": {
                      "type": "string",
                      "pattern": "^(file:[0-9]+|history):line:[0-9]+$"
                    },
                    "type": {
                      "type": "string",
                      "pattern": "^[a-z_]+:[a-z_]+$"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "stage",
              "chunk",
              "outcome"
            ],
            "properties": {
              "kind": {
                "const": "model"
              },
              "stage": {
                "enum": [
                  "stage-1",
                  "stage-2",
                  "stage-3"
                ]
              },
              "chunk": {
                "type": "string",
                "pattern": "^chunk-[0-9]{4,}$"
              },
              "outcome": {
                "enum": [
                  "ok",
                  "ng",
                  "unsure"
                ]
              }
            }
          }
        ]
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "parked"
      ]
    },
    "reason": {
      "enum": [
        "passed",
        "target_binding_invalid",
        "attempt_limit",
        "pii_list_missing",
        "machine_check_unavailable",
        "secret_or_pii_detected",
        "internal_information_detected",
        "image_gps_detected",
        "review_ng",
        "review_unsure",
        "identity_required"
      ]
    },
    "at": {
      "type": "string",
      "minLength": 1
    }
  }
}
