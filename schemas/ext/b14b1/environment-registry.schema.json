{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b14b1/environment-registry.schema.json",
  "title": "環境台帳の見出し（S-25.2）",
  "type": "object",
  "required": ["contract_supported", "environments"],
  "properties": {
    "contract_supported": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}
      ]
    },
    "environments": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
