{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b6b/chat-json-request.schema.json",
  "title": "work/job-<id>/request.json（F-7.2 の chat-json）。worker-pool が書く",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "max_tokens", "messages"],
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "max_tokens": {"type": "integer", "minimum": 1},
    "system": {"type": ["string", "array"]},
    "messages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "content"]}},
    "schema": {"type": "object", "description": "応答の本文（JSON）を検証する JSON Schema。無ければ JSON として読めることだけ見る"},
    "temperature": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
