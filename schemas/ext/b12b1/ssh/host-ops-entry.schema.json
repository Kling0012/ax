{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/ext/b12b1/ssh/host-ops-entry.schema.json",
  "title": "AX host emergency SSH seat registration",
  "description": "F-9.3/S-6.8 host-ops.log JSON Lines entry. Public keys are credentials but not secrets.",
  "type": "object",
  "required": ["seat_id", "via", "tier", "device", "public_key", "key_fp", "actor", "at"],
  "additionalProperties": false,
  "properties": {
    "seat_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"},
    "via": {"const": "ssh"},
    "tier": {"const": "read"},
    "device": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,252}$"},
    "public_key": {"type": "string", "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521) [A-Za-z0-9+/]+={0,2}$"},
    "key_fp": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]+$"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 256},
    "at": {"type": "string", "format": "date-time"}
  }
}
