{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/registry.schema.json",
  "title": "plugins/registry.yaml（S-4.1。tools/build_registry.py が作る）",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/plugin_id"
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/plugin_kind"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "plugins"
  ],
  "additionalProperties": false
}
