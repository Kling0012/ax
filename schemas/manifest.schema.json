{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/manifest.schema.json",
  "title": "プラグインの manifest（S-4.2、S-4.3）",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/plugin_id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/plugin_kind"
    },
    "project": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "execution": {
      "enum": [
        "mechanical",
        "llm"
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "interval",
            "cron",
            "event"
          ]
        },
        "every_s": {
          "type": "integer",
          "minimum": 1
        },
        "cron": {
          "type": "string"
        },
        "missed": {
          "const": "record_only"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/mode"
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "draining"
          }
        }
      ]
    },
    "memory_capabilities": {
      "type": "array",
      "items": {"enum": ["memory.read", "memory.write"]},
      "uniqueItems": true
    },
    "collect_only_handler": {
      "type": "boolean"
    },
    "default_mode": {
      "enum": [
        "collect_only",
        "poll_paused",
        "draining"
      ]
    },
    "skip_observation_target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "knobs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/knob"
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "heartbeat_s": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300
        }
      },
      "required": [
        "heartbeat_s"
      ],
      "additionalProperties": false
    },
    "sensitivity": {
      "$ref": "common.schema.json#/$defs/sensitivity"
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/role"
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on_plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepts_items": {
      "type": "boolean"
    },
    "env_jobs": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "submit",
              "get"
            ]
          },
          "uniqueItems": true
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "operations",
        "entrypoints",
        "requires"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "title",
    "image",
    "execution",
    "schedule",
    "capabilities",
    "health",
    "sensitivity"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "subloop"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "graph"
        ]
      }
    },
    {
      "if": {
        "required": [
          "accepts_items"
        ],
        "properties": {
          "accepts_items": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "subloop"
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "default_mode"
          ]
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "run"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "knob": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "integer",
            "number",
            "boolean",
            "string",
            "enum",
            "duration",
            "list"
          ]
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "items": {}
        },
        "effective": {
          "enum": [
            "immediate",
            "next_run",
            "restart"
          ]
        },
        "title": {
          "type": "string"
        },
        "who": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/issued_by"
          }
        }
      },
      "required": [
        "type",
        "default",
        "effective",
        "title"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enum"
            ]
          }
        }
      ]
    }
  }
}
