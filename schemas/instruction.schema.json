{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/instruction.schema.json",
  "title": "入口の指示（S-6.2）",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "from": {
      "enum": [
        "commander",
        "hq"
      ]
    },
    "destination": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "project": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 200
    },
    "session": {
      "type": "string",
      "maxLength": 64
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "confirm_irreversible": {
      "type": "boolean"
    }
  },
  "required": [
    "from",
    "destination",
    "payload"
  ],
  "additionalProperties": false
}
