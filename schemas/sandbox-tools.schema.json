{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/sandbox-tools.schema.json",
  "type": "object",
  "required": [
    "tools",
    "forbidden_patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "box",
          "paths",
          "instabox",
          "capability"
        ],
        "properties": {
          "box": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "J",
                "G",
                "probe"
              ]
            }
          },
          "arg_rules": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_allow",
              "deny_keys",
              "actions_max"
            ],
            "properties": {
              "action_allow": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "deny_keys": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "actions_max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50
              }
            }
          },
          "instabox": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "capability": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
