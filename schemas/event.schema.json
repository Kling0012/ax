{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/event.schema.json",
  "title": "時系列記録の事象（S-3.2）",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "source": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "principal": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "via": {
          "$ref": "common.schema.json#/$defs/via"
        }
      },
      "required": [
        "component",
        "host"
      ],
      "additionalProperties": false
    },
    "project": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subloop": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "subject": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "corr": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/ulid"
        },
        {
          "type": "null"
        }
      ]
    },
    "cause": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/ulid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "ts",
    "source",
    "kind",
    "subject",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run.state"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/run.state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "job.state"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/job.state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "item.state"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/item.state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plugin.registered"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/plugin.registered"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plugin.mode"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/plugin.mode"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "health.beat"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/health.beat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error.classified"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/error.classified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "control.issued"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/control.issued"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "control.applied"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/control.applied"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "control.expired_pending"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/control.expired_pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "control.released"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/control.released"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "control.renewed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/control.renewed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "state.recorded"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/state.recorded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task.state"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/task.state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resource.state"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/resource.state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resource.repeat_failure"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/resource.repeat_failure"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "health.alert"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/health.alert"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "archive.moved"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/archive.moved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "secret.stored"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/secret.stored"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision.recorded"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "event-data.schema.json#/$defs/decision.recorded"
          }
        }
      }
    }
  ]
}
