{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/dest/decision.record.json",
  "title": "decision.record",
  "$comment": "SPEC.md:S-9.6; id, recorded_by, attested, status and ts are generated by AX",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "decision",
        "preference",
        "handoff"
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "body": {
      "type": "string",
      "maxLength": 600
    },
    "reason": {
      "type": "string",
      "maxLength": 300
    },
    "basis": {
      "enum": [
        "user_said",
        "commander",
        "design"
      ]
    },
    "quote": {
      "type": "string",
      "maxLength": 200
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "title",
    "body",
    "basis"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "basis": {
            "const": "user_said"
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "required": [
          "quote"
        ]
      }
    }
  ]
}
