{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/dest/seat.add.json",
  "title": "seat.add",
  "$comment": "SPEC.md:S-6.8,S-6.10; HQ supplies an SSH credential and the intake derives key_fp",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,252}$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "public_key": {
      "type": "string",
      "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521) [A-Za-z0-9+/]+={0,2}$"
    },
    "tier": {
      "enum": [
        "read",
        "operate",
        "irreversible"
      ]
    }
  },
  "required": [
    "label",
    "device",
    "device_id",
    "public_key",
    "tier"
  ],
  "additionalProperties": false
}
