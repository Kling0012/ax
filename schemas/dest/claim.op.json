{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/dest/claim.op.json",
  "title": "claim.op",
  "$comment": "SPEC.md:S-6.22",
  "type": "object",
  "properties": {
    "op": {
      "enum": [
        "acquire",
        "renew",
        "release"
      ]
    },
    "target_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:._-]+$"
    }
  },
  "required": [
    "op",
    "target_key"
  ],
  "additionalProperties": false
}
