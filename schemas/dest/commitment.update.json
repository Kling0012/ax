{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax.invalid/schemas/dest/commitment.update.json",
  "title": "commitment.update",
  "$comment": "SPEC.md:S-9.5,S-22.5; commitment is the ledger promise record",
  "type": "object",
  "properties": {
    "op": true, "id": true, "body": true, "state": true, "todo_id": true,
    "due_at": true, "version": true, "to": true, "reason": true
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "op": {"const": "create"}, "id": {"type": "string", "minLength": 1}, "body": {"type": "string", "minLength": 1},
        "state": {"enum": ["open", "done", "cancelled"]}, "todo_id": {"type": "string", "minLength": 1}, "due_at": {"type": "string", "minLength": 1}
      },
      "required": ["op", "id", "body", "state", "todo_id", "due_at"],
      "additionalProperties": false
    },
    {
      "properties": {
        "op": {"const": "update"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
        "body": {"type": "string", "minLength": 1}, "todo_id": {"type": "string", "minLength": 1}, "due_at": {"type": "string", "minLength": 1}
      },
      "required": ["op", "id", "version"],
      "anyOf": [{"required": ["body"]}, {"required": ["todo_id"]}, {"required": ["due_at"]}],
      "additionalProperties": false
    },
    {
      "properties": {
        "op": {"const": "transition"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
        "to": {"enum": ["open", "done", "cancelled"]}, "reason": {"type": "string", "minLength": 1}
      },
      "required": ["op", "id", "version", "to", "reason"],
      "additionalProperties": false
    }
  ]
}
